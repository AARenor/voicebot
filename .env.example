# Copy to .env (never commit .env). All secrets via environment only.
# Server port (Coolify sets PORT itself; default 8000 locally).
PORT=8000
# Restaurant is the active product; legacy is archived web adapter verification only.
VOICEBOT_BUSINESS=restaurant
# Separate fictional restaurant ledger, shared with the native worker.
RESTAURANT_STATE_DB=/data/restaurant-booking.db
# Operator token for dashboard confirm/cancel/reset (long random string).
# Server refuses mutating calls when unset; dashboard sends it as
# `Authorization: Bearer <token>`.
OPERATOR_TOKEN=
GROQ_API_KEY=
# Shared by browser turns and telephone worker. Current production Groq models.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
# Includes reasoning tokens; too small a limit can truncate booking arguments.
GROQ_MAX_COMPLETION_TOKENS=2048
# Second LLM provider fallback (Gemini free tier)
GEMINI_API_KEY=
# LiveKit worker target. Secret is reserved but unread by the current web app;
# see architecture risk R-006.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP trunk (carrier-neutral; account/number pending) — unread by code today
SIP_TRUNK_ADDRESS=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_INBOUND_NUMBER=
# Archived hotel/spa adapters. Ignored by the active restaurant pipeline.
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_CLIENT=
MEWS_API_BASE_URL=
CLOUDBEDS_API_KEY=
ZENOTI_API_KEY=
EASY_BASE_URL=
EASY_API_KEY=
# Credentials alone do not enable booking. Synthetic sole-writer demo only.
EASY_DEMO_WRITES=0
# Persistent journal on the container's /data volume; never use ephemeral /tmp.
EASY_STATE_DB=/data/easy-booking.db
EASY_AUTH_SCHEME="Bearer "
EASY_API_PREFIX=/index.php/api/v1
# Fictional room inventory uses the same persistent /data volume.
# When unset, the room demo follows EASY_DEMO_WRITES. Set 0 to disable rooms.
#STAY_DEMO_WRITES=1
STAY_STATE_DB=/data/stay-booking.db
# Optional public demo contact; falls back to TWILIO_PHONE_NUMBER/SIP_INBOUND_NUMBER.
PUBLIC_PHONE_NUMBER=
# Separate booking stack database credentials (runtime environment only).
EASY_DB_PASSWORD=
EASY_DB_ROOT_PASSWORD=
AZURE_SPEECH_KEY=
AZURE_REGION=
AZURE_VOICE=et-EE-AnuNeural
AZURE_LANG=et-EE
# Telephone calls detect Estonian/English/Russian. Use et, en or ru to lock.
VOICEBOT_TELEPHONE_LANGUAGE=auto
# Dedicated English voice; locale and voice prefix must match.
AZURE_EN_VOICE=en-US-JennyNeural
AZURE_EN_LANG=en-US
# Dedicated Russian voice; locale and voice prefix must match.
AZURE_RU_VOICE=ru-RU-SvetlanaNeural
AZURE_RU_LANG=ru-RU
# Natural delivery in supported languages; neutral disables TTS styling/aliases.
VOICEBOT_SPEAKING_STYLE=natural
VOICEBOT_SPEECH_RATE=0.98
VOICEBOT_RECAP_RATE=0.94
# Observability (Langfuse Cloud EU for pilots) — Phase 2 (unread by code yet)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Calls log storage (SQLite file path; default in-memory/ephemeral).
#CALLS_DB=/data/calls.db
# Production guard: blocks test-only reset_default() when set.
#VOICEBOT_PROD=1
