# Copy to .env (never commit .env). All secrets via environment only.
# Server port (Coolify sets PORT itself; default 8000 locally).
PORT=8000
# Operator token for dashboard confirm/cancel/reset (long random string).
# Server refuses mutating calls when unset; dashboard sends it as
# `Authorization: Bearer <token>`.
OPERATOR_TOKEN=
GROQ_API_KEY=
# Second LLM provider fallback (Gemini free tier)
GEMINI_API_KEY=
# LiveKit (self-host or Cloud)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP trunk (DIDHub primary, Twilio fallback)
SIP_TRUNK_ADDRESS=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_INBOUND_NUMBER=
# PMS adapters (fill per property; one venue = one set)
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_CLIENT=
MEWS_API_BASE_URL=
CLOUDBEDS_API_KEY=
ZENOTI_API_KEY=
EASY_BASE_URL=
EASY_API_KEY=
AZURE_SPEECH_KEY=
AZURE_REGION=
AZURE_VOICE=et-EE-AnuNeural
AZURE_LANG=et-EE
# Observability (Langfuse Cloud EU for pilots)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
